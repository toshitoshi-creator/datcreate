{
  "name": "dot-life",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sim": "vite-node scripts/simulate.ts",
    "build:demo": "tsc -b && VITE_DEMO_TIME=1 vite build --outDir dist-demo"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "fake-indexeddb": "^6.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
